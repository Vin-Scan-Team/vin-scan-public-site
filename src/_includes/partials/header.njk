<!-- ===== Шапка (header.css) ===== -->
<header class="header">
  <div class="header__inner">

    <a href="/" class="header__logo" aria-label="Vin-Scan — на главную">
      <img class="header__logo-static" src="/img/logo_header.svg" alt="" width="789" height="252">
      <img class="header__logo-gear" src="/img/logo_gear.svg" alt="" width="244" height="252" aria-hidden="true">
    </a>

    <button class="header__burger" type="button" aria-label="Открыть меню" aria-expanded="false"
      aria-controls="main-nav">
      <span></span><span></span><span></span>
    </button>

    <nav class="nav" id="main-nav" aria-label="Основное меню">
      <ul class="nav__list">
      {%- for item in navigation %}
        <li class="nav__item"><a class="nav__link" href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
      {%- endfor %}
      </ul>

      <!-- Новый блок: телефон + мессенджеры + кнопка -->
      <div class="header__actions">
        <div class="phone">
          <a class="phone__link" href="tel:+79790053559" aria-label="Позвонить: +7 979 005-35-59">
            <svg class="phone__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.6 21 3 13.4 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z"/>
            </svg>
            <span>+7 (979) 005-35-59</span>
          </a>

          <div class="phone__popup">
            <a class="phone__messenger phone__messenger--tg" href="https://t.me/VinScanRU"
              target="_blank" rel="noopener noreferrer" aria-label="Telegram (откроется в новой вкладке)">
              <svg class="phone__messenger-icon phone__messenger-icon--tg" viewBox="0 0 48 48" aria-hidden="true">
                <path d="M41.4193 7.30899C41.4193 7.30899 45.3046 5.79399 44.9808 9.47328C44.8729 10.9883 43.9016 16.2908 43.1461 22.0262L40.5559 39.0159C40.5559 39.0159 40.3401 41.5048 38.3974 41.9377C36.4547 42.3705 33.5408 40.4227 33.0011 39.9898C32.5694 39.6652 24.9068 34.7955 22.2086 32.4148C21.4531 31.7655 20.5897 30.4669 22.3165 28.9519L33.6487 18.1305C34.9438 16.8319 36.2389 13.8019 30.8426 17.4812L15.7331 27.7616C15.7331 27.7616 14.0063 28.8437 10.7686 27.8698L3.75342 25.7055C3.75342 25.7055 1.16321 24.0823 5.58815 22.459C16.3807 17.3729 29.6555 12.1786 41.4193 7.30899Z"/>
              </svg>
              <span>Telegram</span>
            </a>

            <a class="phone__messenger phone__messenger--max" href="https://max.ru/u/f9LHodD0cOKa-zuqYwXGyq91kErDhUCwsnc6W33V5822dwCx7ND5D0halkg"
              target="_blank" rel="noopener noreferrer" aria-label="MAX (откроется в новой вкладке)">
              <img class="phone__messenger-icon phone__messenger-icon--max" src="/img/logo-max.svg" alt="" width="24" height="24">
              <span>MAX</span>
            </a>
          </div>
        </div>

        <a href="/contacts/" class="btn btn--primary">Стань пилотом</a>
      </div>
    </nav>

  </div>
</header>
